# syntax=docker/dockerfile:1

# Base image with Go and Air
FROM golang:1.24

# Set working directory
WORKDIR /app

# Install Air for live reload
RUN go install github.com/air-verse/air@latest

# Copy go.mod and go.sum first and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy the source code (optional if using bind mounts in docker-compose)
COPY . .

# Expose port
EXPOSE 8080

# Start with Air for live reloading
CMD ["air", "-c", ".air.toml"]
